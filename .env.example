# Провайдер LLM: openai | nvidia | demo
LLM_PROVIDER=openai

# OpenAI (кредиты хакатона)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_MODEL=gpt-5.4

# NVIDIA NIM (build.nvidia.com), совместим с OpenAI SDK
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Режим проверки без ключей: ответы модели берутся из data/cache/demo_responses.json
DEMO_MODE=false

# Сервис
APP_HOST=0.0.0.0
APP_PORT=8000
